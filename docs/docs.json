{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Langmail",
  "description": "Email, calendar and contacts for the way they're handled now: by agents. Documentation for the Langmail MCP server and open-protocol surface.",
  "colors": {
    "primary": "#3E6E96",
    "light": "#7FA6C9",
    "dark": "#3E6E96"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://langmail.me"
  },
  "favicon": "/favicon.svg",
  "appearance": {
    "default": "dark"
  },
  "background": {
    "color": {
      "light": "#F1F4F7",
      "dark": "#191C21"
    }
  },
  "fonts": {
    "family": "IBM Plex Sans"
  },
  "navbar": {
    "links": [
      {
        "type": "discord",
        "label": "Discord",
        "href": "https://discord.gg/CabhN3xuyk"
      },
      {
        "label": "Blog",
        "href": "https://langmail.me/blog"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get started",
      "href": "https://app.langmail.me"
    }
  },
  "contextual": {
    "options": ["copy", "view", "claude", "cursor"]
  },
