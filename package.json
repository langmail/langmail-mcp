{
  "name": "@langmail/mcp",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "bun run src/index.ts",
    "measure:tool-size": "bun run scripts/measure-indexed-size.ts",
    "smoke": "bun run scripts/smoke.ts",
    "smoke:agent-type-filter": "bun run scripts/smoke-agent-type-filter.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "test": "bun test",
    "test:integration": "bun test caldav-integration",
    "test:stalwart": "bun test stalwart-update-organizer stalwart-cancel-occurrence stalwart-attendee-delta attachments-stalwart mail-rules-stalwart search-contacts-stalwart search-emails-stalwart drafts-stalwart draft-attachments-stalwart",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@langmail/agents": "*",
    "@langmail/contacts": "*",
    "@langmail/ical": "*",
    "@langmail/jmap": "*",
    "@langmail/logger": "*",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@touch4it/ical-timezones": "^1.9.0",
    "ical-generator": "^11.0.0",
    "langmail": "^0.11.2",
    "rrule": "^2.8.1",
    "tsdav": "^2.2.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@langmail/tsconfig": "*",
    "typescript": "^6.0.3"
  }
}
