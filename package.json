{
  "name": "@langmail/mcp",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && tsc --noEmit -p src/email-render/viewer",
    "dev": "bun run src/index.ts",
    "measure:tool-size": "bun run scripts/measure-indexed-size.ts",
    "smoke": "bun run scripts/smoke.ts",
    "smoke:agent-preview": "bun run scripts/smoke-agent-preview.ts",
    "smoke:agent-type-filter": "bun run scripts/smoke-agent-type-filter.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "test": "bun test",
    "test:integration": "bun test caldav-integration",
    "test:stalwart": "bun test stalwart-update-organizer stalwart-cancel-occurrence stalwart-move-occurrence stalwart-attendee-delta attachments-stalwart mail-rules-stalwart search-contacts-stalwart contacts-write-stalwart search-emails-stalwart drafts-stalwart draft-attachments-stalwart file-emails-stalwart",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/email-render/viewer"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@langmail/agents": "*",
    "@langmail/contacts": "*",
    "@langmail/ical": "*",
    "@langmail/jmap": "*",
    "@langmail/logger": "*",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@touch4it/ical-timezones": "^1.9.0",
    "ical-generator": "^11.0.0",
    "langmail": "^0.11.2",
    "rrule": "^2.8.1",
    "sanitize-html": "^2.17.7",
    "tsdav": "^2.2.2",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.2",
    "@langmail/tsconfig": "*",
    "@types/sanitize-html": "^2.16.1",
    "typescript": "^6.0.3"
  }
}
