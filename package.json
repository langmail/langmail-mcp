{
  "name": "langmail-mcp",
  "version": "0.2.0",
  "private": true,
  "description": "Langmail's MCP server for your own Stalwart mailbox: mail, calendar and contacts for an AI agent, over stdio or Streamable HTTP",
  "type": "module",
  "bin": {
    "langmail-mcp": "dist/langmail-mcp.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --noEmit && tsc --noEmit -p src/email-render/viewer",
    "build:package": "bun run scripts/build-package.ts",
    "check:package": "bun run scripts/check-package.ts",
    "dev": "bun run src/index.ts",
    "measure:tool-size": "bun run scripts/measure-indexed-size.ts",
    "prepack": "bun run build:package",
    "smoke": "bun run scripts/smoke.ts",
    "smoke:agent-apple-mail-draft": "bun run scripts/smoke-agent-apple-mail-draft.ts",
    "smoke:agent-calendar-share": "bun run scripts/smoke-agent-calendar-share.ts",
    "smoke:agent-contact-from-mail": "bun run scripts/smoke-agent-contact-from-mail.ts",
    "smoke:agent-contact-large-book": "bun run scripts/smoke-agent-contact-large-book.ts",
    "smoke:agent-contact-role": "bun run scripts/smoke-agent-contact-role.ts",
    "smoke:agent-contact-role-record": "bun run scripts/smoke-agent-contact-role-record.ts",
    "smoke:agent-forward": "bun run scripts/smoke-agent-forward.ts",
    "smoke:agent-preview": "bun run scripts/smoke-agent-preview.ts",
    "smoke:agent-self-hosted": "bun run scripts/smoke-agent-self-hosted.ts",
    "smoke:agent-type-filter": "bun run scripts/smoke-agent-type-filter.ts",
    "smoke:agent-windows-zone": "bun run scripts/smoke-agent-windows-zone.ts",
    "spec:check": "./spec/check.sh",
    "start": "NODE_ENV=production bun src/index.ts",
    "start:self-hosted": "bun --no-env-file src/self-hosted.ts",
    "test": "bun test",
    "test:integration": "bun test caldav-integration",
    "test:node": "bun run scripts/test-node.ts",
    "test:stalwart": "bun test calendar-feed-stalwart stalwart-all-day-event stalwart-update-organizer stalwart-update-calendar stalwart-cancel-occurrence stalwart-move-occurrence stalwart-move-event stalwart-duplicate-uid-itip stalwart-reply-unmodified-instance stalwart-attendee-delta stalwart-series-edit-keeps-partstat stalwart-update-keeps-properties attachments-stalwart mail-rules-stalwart search-contacts-stalwart contacts-write-stalwart search-emails-stalwart drafts-stalwart draft-attachments-stalwart file-emails-stalwart unsubscribe-stalwart",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/email-render/viewer"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@logtail/node": "^0.6.1",
    "@logtail/types": "^0.6.0",
    "@modelcontextprotocol/ext-apps": "~2.0.4",
    "@modelcontextprotocol/server": "^2.4.0",
    "@sentry/node": "^11.12.0",
    "ical-generator": "^11.1.3",
    "langmail": "^0.11.2",
    "pino": "^10.4.0",
    "rrule": "^2.8.1",
    "sanitize-html": "^2.18.2",
    "timezones-ical-library": "^3.0.0",
    "tsdav": "^2.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/bun": "^1.3.3",
    "@types/sanitize-html": "^2.16.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "^22.12.0 || >=24"
  }
}
