                      "minLength": 1,
                      "pattern": "^[^\\u0000-\\u001F\\u007F]*$",
                      "type": "string",
                    },
                    "type": {
                      "const": "copy",
                      "type": "string",
                    },
                  },
                  "required": [
                    "mailbox",
                    "type",
                  ],
                  "type": "object",
                },
                {
                  "properties": {
                    "tag": {
                      "description": "Tag name, e.g. "GitHub"; slugified to a tag id ("Acme Corp" -> "acme-corp").",
                      "maxLength": 50,
                      "minLength": 1,
                      "pattern": "^[^\\u0000-\\u001F\\u007F]*$",
                      "type": "string",
                    },
                    "type": {
                      "const": "addTag",
                      "type": "string",
                    },
                  },
                  "required": [
                    "tag",
                    "type",
                  ],
                  "type": "object",
                },
                {
                  "properties": {
                    "tag": {
                      "maxLength": 50,
                      "minLength": 1,
                      "pattern": "^[^\\u0000-\\u001F\\u007F]*$",
                      "type": "string",
                    },
                    "type": {
                      "const": "removeTag",
                      "type": "string",
                    },
                  },
                  "required": [
                    "tag",
                    "type",
                  ],
                  "type": "object",
                },
                {
                  "properties": {
                    "type": {
                      "const": "markRead",
                      "type": "string",
                    },
                  },
                  "required": [
                    "type",
                  ],
                  "type": "object",
                },
                {
                  "properties": {
                    "type": {
                      "const": "markUnread",
                      "type": "string",
                    },
                  },
                  "required": [
                    "type",
                  ],
                  "type": "object",
                },
                {
                  "description": "Flag/star it.",
                  "properties": {
                    "type": {
                      "const": "flag",
                      "type": "string",
                    },
                  },
                  "required": [
                    "type",
                  ],
                  "type": "object",
                },
                {
                  "description": "Move it to Trash (not a permanent erase).",
                  "properties": {
                    "type": {
                      "const": "delete",
                      "type": "string",
                    },
                  },
                  "required": [
                    "type",
                  ],
                  "type": "object",
                },
                {
                  "properties": {
                    "to": {
                      "description": "Forward a copy here; the original still lands in the mailbox.",
                      "format": "email",
                      "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
                      "type": "string",
                    },
                    "type": {
                      "const": "forward",
                      "type": "string",
                    },
                  },
                  "required": [
                    "to",
                    "type",
                  ],
                  "type": "object",
                },
                {
                  "description": "Skip any later rules for this message. Only useful as the last action.",
                  "properties": {
                    "type": {
                      "const": "stopProcessing",
                      "type": "string",
                    },
                  },
                  "required": [
                    "type",
                  ],
                  "type": "object",
                },
              ],
            },
            "maxItems": 10,
            "minItems": 1,
            "type": "array",
          },
          "conditions": {
            "description": "When the rule fires; at least one is required. Matching is case-insensitive substring matching.",
            "properties": {
              "bodyContains": {
                "description": "Message body contains this text.",
                "maxLength": 200,
                "minLength": 1,
                "pattern": "^[^\\u0000-\\u001F\\u007F]*$",
                "type": "string",
              },
              "from": {
                "description": "Sender (From) contains this — an address, a domain like "github.com", or a name like "Acme Corp".",
                "maxLength": 200,
                "minLength": 1,
                "pattern": "^[^\\u0000-\\u001F\\u007F]*$",
                "type": "string",
              },
              "hasAttachment": {
                "description": "true matches messages that look like they carry an attachment (heuristic); false means "not set".",
                "type": "boolean",
              },
              "subject": {
                "description": "Subject line contains this.",
                "maxLength": 200,
                "minLength": 1,
                "pattern": "^[^\\u0000-\\u001F\\u007F]*$",
                "type": "string",
              },
              "to": {
                "description": "A To/Cc recipient contains this (address or name).",
                "maxLength": 200,
                "minLength": 1,
                "pattern": "^[^\\u0000-\\u001F\\u007F]*$",
                "type": "string",
              },
            },
            "type": "object",
          },
          "existingMail": {
            "description": "The existing-mail policy being considered — its scope decides where matches are counted (default: inbox).",
            "properties": {
              "confirmLargeApply": {
                "description": "Must be true to apply to more than 200 existing messages; preview_mail_rule first and let the user confirm the count.",
                "type": "boolean",
              },
              "mode": {
                "default": "none",
                "description": "What existing mail to act on: "none" (default — future mail only), "messages", or "conversations" (whole threads).",
                "enum": [
                  "none",
                  "messages",
                  "conversations",
                ],
                "type": "string",
              },
              "scope": {
                "default": "inbox",
                "description": "Where to look for existing matches: "inbox" (default) or "all" mail.",
                "enum": [
                  "inbox",
                  "all",
                ],
                "type": "string",
              },
            },
            "type": "object",
          },
          "match": {
            "default": "all",
            "description": "How multiple conditions combine: "all" = every condition must match (AND), "any" = one is enough (OR).",
            "enum": [
              "all",
              "any",
            ],
            "type": "string",
          },
          "name": {
            "description": "Optional human-readable rule name, e.g. "Archive GitHub Notifications".",
            "maxLength": 200,
            "minLength": 1,
            "type": "string",
          },
        },
        "required": [
          "actions",
          "conditions",
        ],
        "type": "object",
      },
