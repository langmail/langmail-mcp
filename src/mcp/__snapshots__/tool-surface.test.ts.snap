              "oneOf": [
                {
                  "description": "Move it out of the Inbox into Archive.",
                  "properties": {
                    "type": {
                      "const": "archive",
                      "type": "string",
                    },
                  },
                  "required": [
                    "type",
                  ],
                  "type": "object",
                },
                {
                  "properties": {
                    "mailbox": {
                      "description": "Target mailbox/folder name; created if missing.",
                      "maxLength": 100,
                      "minLength": 1,
                      "pattern": "^[^\\u0000-\\u001F\\u007F]*$",
                      "type": "string",
                    },
                    "type": {
                      "const": "move",
                      "type": "string",
                    },
                  },
                  "required": [
                    "mailbox",
                    "type",
                  ],
                  "type": "object",
                },
                {
                  "properties": {
                    "mailbox": {
                      "description": "Target mailbox/folder name; created if missing.",
