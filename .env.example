# Your own Stalwart server (JMAP, CalDAV and CardDAV live under this URL).
# Always use HTTPS.
STALWART_URL=https://mail.example.com

# Sign in with an app password ...
STALWART_USERNAME=you@example.com
STALWART_PASSWORD=your-app-password
# ... or with a bearer token instead of username + password.
# STALWART_TOKEN=

# Transport. The default is stdio (agent on the same computer). Set
# MCP_TRANSPORT=http (or pass --http) to serve Streamable HTTP at /mcp, for an
# agent on the same server or across the network.
# MCP_TRANSPORT=http
# Required in HTTP mode: a secret of at least 16 printable characters without
# spaces (`openssl rand -hex 32` makes one). Callers send it as
# `Authorization: Bearer <secret>`; anything else gets a 401.
# MCP_AUTH_TOKEN=
# The address and port to listen on. The default is reachable from this
# machine only. The server speaks plain HTTP: before you bind another address,
# put a reverse proxy that terminates TLS in front of it.
# MCP_HOST=127.0.0.1
# MCP_PORT=8080
# The address callers reach the server under, when it is not MCP_HOST:MCP_PORT.
# Download and upload links for attachments are handed out under this address
# (<MCP_PUBLIC_URL>/attachments/...), and so are the images of an email shown
# with preview_email. Such a link works without the token for as long as it
# is valid, so keep those paths out of a reverse proxy's access log.
# MCP_PUBLIC_URL=https://mcp.example.com

# Over stdio nothing listens until the agent asks for an attachment link or
# the client shows an email with preview_email. The links are then served on
# 127.0.0.1 only, on a free port, or on MCP_PORT if you set it (a free port
# is used when that one is taken).

# Logs go to stderr. Levels: fatal, error, warn (the default), info (adds one
# line per tool call), debug, trace, silent.
# LOG_LEVEL=info

# Traffic to anything but your Stalwart is off unless you turn it on.
# One-click unsubscribe (RFC 8058) POSTs to the sender's URL:
# LANGMAIL_MCP_ALLOW_UNSUBSCRIBE_POST=1
# preview_email shows an email's own inline images only, and leaves out the
# ones the email loads from the sender's servers. With this on, the server
# fetches those images itself and passes them on (<MCP_PUBLIC_URL>/image-proxy/...),
# so the sender sees the server's address, not the reader's:
# LANGMAIL_MCP_ALLOW_REMOTE_IMAGES=1

# Copy this file to .env and fill in your own values. .env is git-ignored.
